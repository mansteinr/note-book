{
  "name": "sass-guide-project",
  "version": "1.0.0",
  "description": "Sass 使用指南和示例项目",
  "main": "index.js",
  "scripts": {
    "sass:compile": "sass example.scss example.css",
    "sass:watch": "sass --watch example.scss:example.css",
    "sass:build": "sass example.scss example.css --style compressed",
    "sass:build-expanded": "sass example.scss example.css --style expanded",
    "sass:build-compressed": "sass example.scss example.min.css --style compressed",
    "sass:compile-dir": "sass src/scss:dist/css",
    "sass:watch-dir": "sass --watch src/scss:dist/css",
    "sass:build-dir": "sass src/scss:dist/css --style compressed",
    "dev": "npm run sass:watch",
    "build": "npm run sass:build",
    "serve": "npx serve .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "sass",
    "scss",
    "css",
    "preprocessor",
    "frontend",
    "web-development"
  ],
  "author": "Sass Guide",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.77.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/example/sass-guide.git"
  },
  "bugs": {
    "url": "https://github.com/example/sass-guide/issues"
  },
  "homepage": "https://github.com/example/sass-guide#readme"
}